# Boom Environment Configuration

PORT=5000
NODE_ENV=development

# JWT Secret for authenticating sessions
JWT_SECRET=boom_super_secure_jwt_secret_change_in_production_2026

# Allowed CORS Origin for web client (e.g. https://boom.example.com or http://localhost:3000)
CORS_ORIGIN=*

# PostgreSQL Connection String (Leave empty for zero-setup local dev)
DATABASE_URL=postgres://boom:boom_secure_pass@localhost:5432/boom_db

# Maximum participants per meeting room in MVP
MAX_PARTICIPANTS=10

# WebRTC STUN / TURN Configuration
# ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]

# Optional production TURN credentials endpoint (keep the provider secret server-side).
# Example: https://YOUR_APP.metered.live/api/v1/turn/credentials?apiKey=YOUR_API_KEY
METERED_TURN_CREDENTIALS_URL=
